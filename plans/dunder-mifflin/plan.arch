# Dunder Mifflin Paper Company, Scranton Branch — second floor, the office suite.
#
# A paper company deserves a paper drawing. This plan exists for one reason: to put an
# OFFICIAL SQUARE METERAGE on the annex — and on every other room a sitcom has spent nine
# seasons treating as a feeling rather than a floor area.
#
# The mechanism is two statements at the top of the plan and five wrappers below them:
#
#   `zone <id> "Label" { … }`  a WING/DEPARTMENT grouping with ZERO geometry. Every
#                              statement inside resolves exactly as if the wrapper were
#                              deleted — same coordinates, same ids, byte-identical SVG.
#                              Membership is DECLARED, never inferred from where a room
#                              happens to sit.
#   `schedule rooms`           draws the room schedule under the title block: NO. · NAME ·
#                              AREA (m²). With `zone` blocks present, the rows GROUP by
#                              zone and each group closes with a SUBTOTAL row — so
#                              "how much floor is Management?" is a read, not a sum.
#
# Everything in the schedule is derived from the rooms themselves; there is not a single
# area typed anywhere in this file. `arch describe --json` reports the same numbers under
# `zones[]` and `schedule[]`, which is the proof that the drawing and the table cannot
# drift apart.
#
# Fan art. This is an ORIGINAL drawing of a fictional set's layout as documented by fans —
# not an official record, and not affiliated with the show or its rights holders.
plan "Dunder Mifflin — Scranton Branch" {
  units mm
  # `grid 50`: the partitions are 200 thick and the glass walls 100, so a fixture backed
  # onto a face lands on a …50 coordinate that a 100 grid could not express.
  grid 50
  # A2, not A3. At 1:100 the drawing needs 18300 of height on its outer faces, and the
  # five-group schedule plus the legend take 181.5 mm of sheet before the building gets
  # any — so an A3 was 6.75 m short and said so (`W_SCALE_OVERFLOW`). The table is the
  # punchline of this drawing, so the sheet moved rather than the table.
  paper A2 landscape
  scale 1:100
  north up
  dims auto all
  schedule rooms
  legend

  # The public side is the lift lobby on the north facade — the doors everyone walks
  # through. `site` draws NOTHING; it only names the five directions `describe --json`
  # reports, and it is a drafting heuristic for an aspect, never a daylight claim.
  site { street north }

  accTitle "Dunder Mifflin Scranton branch office — floor plan"
  accDescr "An open-plan office suite: management offices and reception along the north facade, an open sales bullpen through the middle, and kitchen, restrooms and the annex across the back."

  # ---- shell --------------------------------------------------------------------
  # 30 x 18 m of leased floor, one storey, and the only load-bearing thing in the plan.
  wall id=shell exterior thickness 300 material concrete { (0,0) (30000,0) (30000,18000) (0,18000) close }

  # ---- partitions: the north band ------------------------------------------------
  # Michael's office and the conference room take the north-west corner; reception sits
  # beside the entrance; accounting has the north-east corner.
  wall id=w_mich_e partition thickness 200 { (7000,0) (7000,6000) }
  wall id=w_conf_e partition thickness 200 { (14500,0) (14500,6000) }
  # A screen, not a wall: it stops 2000 short of the bullpen, so accounting is a CORNER of
  # the open floor rather than a room you need a door for.
  wall id=w_acct_w partition thickness 100 { (22000,0) (22000,4000) }

  # The famous glass line. `material none` is the honest hatch for glazing — a partition
  # that is drawn but not filled. Both doors hang off it, side by side, exactly where the
  # show puts them.
  wall id=w_mich_s partition thickness 100 material none { (0,6000) (7000,6000) }
  wall id=w_conf_s partition thickness 100 material none { (7000,6000) (14500,6000) }
  # The glass carries on past reception as a waist-high screen, and turns into a low
  # divider around the accounting corner. Both are punched by a cased `opening` wide
  # enough that the floor still reads as one room — but an opening is what puts the two
  # spaces on the access graph, and "you can obviously walk there" is not a connection a
  # compiler is allowed to assume.
  wall id=w_recep_s partition thickness 100 material none { (14500,6000) (22000,6000) }
  wall id=w_acct_s  partition thickness 100 { (22000,6000) (30000,6000) }

  # ---- partitions: the back band -------------------------------------------------
  wall id=w_kitch_n partition thickness 200 { (0,12500) (8500,12500) }
  wall id=w_corr_n  partition thickness 200 { (8500,12500) (21500,12500) }
  wall id=w_annex_n partition thickness 200 { (21500,12500) (30000,12500) }
  wall id=w_kitch_e partition thickness 200 { (8500,12500) (8500,18000) }
  wall id=w_wc_n    partition thickness 200 { (8500,14500) (21500,14500) }
  wall id=w_wcm_e   partition thickness 200 { (13000,14500) (13000,18000) }
  wall id=w_wcw_e   partition thickness 200 { (17500,14500) (17500,18000) }
  wall id=w_annex_w partition thickness 200 { (21500,12500) (21500,18000) }

  # ================================================================================
  # ROOMS, grouped by department. The five `zone` blocks below are the whole joke: they
  # add no geometry at all, and they are what turns the schedule into a departmental
  # budget line for spaces that have never had one.
  # ================================================================================

  zone mgmt "Management" {
    # A corner office: windows on two facades, glass on the third. Its door and the
    # conference room's open onto the bullpen within a metre of each other.
    room id=r_michael at (0,0) size 7000x6000 label "Michael's Office" uses office
    room id=r_conf    at (7000,0) size 7500x6000 label "Conference Room" uses office
  }

  zone sales "Sales Floor" {
    room id=r_recep   at (14500,0) size 7500x6000 label "Reception" uses entry office
    room id=r_bullpen at (0,6000) size 30000x6500 label "The Bullpen" uses office circulation
  }

  zone acct "Accounting" {
    room id=r_acct at (22000,0) size 8000x6000 label "Accounting" uses office
  }

  zone amen "Amenities" {
    room id=r_kitchen at (0,12500) size 8500x5500 label "Kitchen & Break Room" uses kitchen
    room id=r_corr    at (8500,12500) size 13000x2000 label "Back Corridor" uses circulation
    room id=r_wc_m    at (8500,14500) size 4500x3500 label "Men's Room" uses wc
    room id=r_wc_w    at (13000,14500) size 4500x3500 label "Women's Room" uses wc
    room id=r_supply  at (17500,14500) size 4000x3500 label "Supply Closet" uses storage
  }

  zone annex "Annex" {
    # The appendix. One door off the bullpen, the back stair down to the warehouse at the
    # far end, and — as of this drawing — a number.
    room id=r_annex at (21500,12500) size 8500x5500 label "Annex" uses office
  }

  # ---- doors ----------------------------------------------------------------------
  # `on <wall> at <pos>` pins each opening to its host BY CONSTRUCTION: <pos> walks the
  # wall's own run from its first point, so no door here can ever be reported off-wall.
  door id=d_entry   on shell     at 18000 width 1800 swing into r_recep   # from the lift lobby
  door id=d_michael on w_mich_s  at 5200  width 900  swing into r_michael
  door id=d_conf    on w_conf_s  at 1200  width 1000 swing into r_conf
  door id=d_conf_n  on w_conf_e  at 4200  width 900  swing into r_conf   # the short way in, from reception
  door id=d_annex   on w_annex_n at 2500  width 1000 swing into r_annex
  door id=d_wc_m    on w_wc_n    at 2250  width 900  swing into r_wc_m
  door id=d_wc_w    on w_wc_n    at 6750  width 900  swing into r_wc_w
  # The supply closet takes a pocket door: its leaf would otherwise sweep the corridor
  # everyone queues down on their way to the restrooms.
  door id=d_supply  pocket on w_wc_n at 11000 width 900 slide right

  # Cased openings — no leaf, but they still connect the two spaces in the access graph.
  opening id=o_recep   on w_recep_s at 3500 width 3000
  opening id=o_acct    on w_acct_s  at 4000 width 3000
  opening id=o_kitchen on w_kitch_n at 6500 width 2000
  opening id=o_corr    on w_corr_n  at 2000 width 1500

  # ---- glazing --------------------------------------------------------------------
  # North facade: the two management rooms, reception either side of the entrance, and
  # accounting's corner.
  window at (2000,0)  width 1500 wall shell
  window at (5000,0)  width 1500 wall shell
  window at (8800,0)  width 1800 wall shell
  window at (12500,0) width 1800 wall shell
  window at (15850,0) width 1500 wall shell
  window at (20500,0) width 1500 wall shell
  window at (23500,0) width 1800 wall shell
  window at (27500,0) width 1800 wall shell

  # West facade: Michael's corner, the bullpen, the break room.
  window at (0,2000)  width 1500 wall shell
  window at (0,4200)  width 1200 wall shell
  window at (0,8000)  width 1800 wall shell
  window at (0,10500) width 1800 wall shell
  window at (0,14000) width 1500 wall shell
  window at (0,16500) width 1500 wall shell

  # East facade: accounting's corner, the bullpen, the annex.
  window at (30000,2000)  width 1800 wall shell
  window at (30000,4200)  width 1200 wall shell
  window at (30000,8000)  width 1800 wall shell
  window at (30000,10500) width 1800 wall shell
  window at (30000,13500) width 1200 wall shell

  # South facade: the break room and the annex.
  window at (3000,18000)  width 1800 wall shell
  window at (6000,18000)  width 1500 wall shell
  window at (23000,18000) width 1800 wall shell
  window at (25500,18000) width 1800 wall shell

  # ================================================================================
  # FIT-OUT
  # ================================================================================

  # ---- Michael's office ------------------------------------------------------------
  # The desk faces the door, which is the entire management philosophy of this branch.
  furniture id=f_michael desk    at (2200,1400) size 2200x900  label "Michael" in r_michael
  furniture id=f_guest1  chair   at (2600,2800) size 600x600   in r_michael
  furniture id=f_guest2  chair   at (3600,2800) size 600x600   in r_michael
  furniture id=f_cred    cabinet at (300,4400)  size 2000x500  label "Credenza" in r_michael

  # ---- the conference room ---------------------------------------------------------
  # The long table, and twelve chairs generated by a loop rather than typed out. Every
  # seat is derived from the table's own centre line.
  furniture id=f_table table at (8750,2300) size 4000x1400 label "Conference table" in r_conf
  for i in 0..5 {
    furniture chair at (8850 + i * 800, 1600) size 550x550 in r_conf
    furniture chair at (8850 + i * 800, 3850) size 550x550 in r_conf
  }
  furniture chair at (8050,2700)  size 550x550 in r_conf
  furniture chair at (12950,2700) size 550x550 in r_conf

  # ---- reception -------------------------------------------------------------------
  # Pam's desk sits square to the entrance, facing whoever comes through it.
  furniture id=f_pam   desk    at (16800,2600) size 2400x800  label "Pam" in r_recep
  furniture id=f_wait  sofa    at (14800,600)  size 700x2000  label "Waiting" in r_recep
  furniture id=f_files cabinet at (20200,600)  size 1600x500  label "Files" in r_recep

  # ---- the bullpen: three desk clusters --------------------------------------------
  # Each cluster is two desks pushed face to face — they share an edge, which is why the
  # y of the second desk is the y of the first plus its depth and nothing else.
  furniture id=f_andy    desk at (4000,7200)  size 1600x750 label "Andy" in r_bullpen
  furniture id=f_creed   desk at (4000,7950)  size 1600x750 label "Creed" in r_bullpen
  furniture id=f_stanley desk at (10000,7200) size 1600x750 label "Stanley" in r_bullpen
  furniture id=f_phyllis desk at (10000,7950) size 1600x750 label "Phyllis" in r_bullpen
  furniture id=f_jim     desk at (16000,7200) size 1600x750 label "Jim" in r_bullpen
  furniture id=f_dwight  desk at (16000,7950) size 1600x750 label "Dwight" in r_bullpen
  furniture id=f_mere    desk at (22000,7200) size 1600x750 label "Meredith" in r_bullpen

  furniture id=f_copier  copier  at (26000,7200)  size 1600x800  label "Copier" in r_bullpen
  furniture id=f_cooler  cooler  at (13000,11700) size 1600x600  label "Water cooler" in r_bullpen
  furniture id=f_bfiles  cabinet at (2000,11900)  size 3000x500  label "Files" in r_bullpen

  # ---- the accounting corner -------------------------------------------------------
  furniture id=f_angela desk    at (23000,1400) size 1800x800 label "Angela" in r_acct
  furniture id=f_kevin  desk    at (23000,2200) size 1800x800 label "Kevin" in r_acct
  furniture id=f_oscar  desk    at (26500,1400) size 1800x800 label "Oscar" in r_acct
  furniture id=f_afiles cabinet at (23000,4200) size 2400x500 label "Files" in r_acct

  # ---- kitchen & break room --------------------------------------------------------
  # `against wall <id> offset <mm>` puts the piece's CENTRE that far along the wall and
  # derives the depth off the face, the quarter-turn, and — for a catalogued fixture —
  # the footprint. No coordinate and no half-thickness is written here.
  furniture id=f_counter counter      against wall w_kitch_e offset 1400 size 2000x600 label "Counter" in r_kitchen
  furniture id=f_sink    kitchen_sink against wall w_kitch_e offset 3200 in r_kitchen
  furniture id=f_fridge  fridge       against wall w_kitch_e offset 4400 in r_kitchen
  furniture id=f_vend    vending      in r_kitchen anchor top flush size 1800x800 label "Vending"
  furniture id=f_tbl1    table        at (1500,14400) size 1600x900 label "Break table" in r_kitchen
  furniture id=f_tbl2    table        at (1500,16200) size 1600x900 label "Break table" in r_kitchen
  for i in 0..2 {
    furniture chair at (1800 + i * 800, 13700) size 550x550 in r_kitchen
    furniture chair at (1800 + i * 800, 15500) size 550x550 in r_kitchen
    furniture chair at (1800 + i * 800, 17250) size 550x550 in r_kitchen
  }

  # ---- restrooms -------------------------------------------------------------------
  furniture id=f_wcm1 wc    against wall w_wcm_e   offset 1200 in r_wc_m
  furniture id=f_wcm2 wc    against wall w_wcm_e   offset 2100 in r_wc_m
  furniture id=f_bsm  basin against wall w_kitch_e offset 4600 in r_wc_m
  furniture id=f_wcw1 wc    against wall w_wcw_e   offset 1200 in r_wc_w
  furniture id=f_wcw2 wc    against wall w_wcw_e   offset 2100 in r_wc_w
  furniture id=f_bsw  basin against wall w_wcm_e   offset 2600 in r_wc_w

  # ---- supply closet ---------------------------------------------------------------
  furniture id=f_sup1 cabinet at (17700,17350) size 3600x500 label "Supplies" in r_supply
  # No label on the tall run: a 500-wide box cannot hold one at the fixture text size,
  # and an overflowing label is worse than none.
  furniture id=f_sup2 cabinet at (20900,15100) size 500x2000 in r_supply

  # ---- the annex -------------------------------------------------------------------
  furniture id=f_toby  desk at (22200,15000) size 1800x800 label "Toby" in r_annex
  furniture id=f_kelly desk at (22200,16400) size 1800x800 label "Kelly" in r_annex
  furniture id=f_ryan  desk at (24800,15000) size 1800x800 label "Ryan" in r_annex

  # The back stair down to the warehouse. `dir down` is entered from the end nearest the
  # annex door, so the DN arrow reads the way you actually walk it.
  stair id=s_back at (27200,14500) size 1800x3000 dir down

  title {
    # The title block's project cell is a fixed 34 mm wide on the sheet, so the full
    # "Dunder Mifflin Paper Company — Scranton Branch" overprints its own PROJECT label.
    # The branch is named by the plan title, the schedule and every room on it.
    project "Dunder Mifflin Paper Co."
    drawn_by "ArchLang"
    date "2026-08-25"
  }
}
