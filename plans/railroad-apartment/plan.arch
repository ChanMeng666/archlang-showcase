# "2BR* — $2,950/mo — cozy, full of character"
#
# A FICTIONAL COMPOSITE of a genre: the New York railroad walk-up that goes
# viral once a month. Not a real listing, not a real address, not a real
# building. Every awful thing in it is a thing that is legal, rented, and
# photographed with a wide-angle lens somewhere in this city.
#
# The shape is the whole problem. The unit measures 3.7 x 18.3 m over its outer
# faces — 3.1 m of clear width once the two 300 mm party walls are taken out, and
# 900 mm of THAT is corridor. Both long sides are shared with the buildings next
# door, so there are exactly TWO facades that can hold glass: the street (north)
# and the rear airshaft (south). Everything in between borrows its daylight.
#
# The apartment is drawn honestly: real dimensions, real fixtures, real doors.
# Nothing is exaggerated for the joke. The joke is `lint.txt`.
plan "Railroad Walk-Up — Unit 3R" {
  units mm
  grid 50
  paper A2 portrait
  scale 1:50
  north up
  dims auto overall
  site { street north hemisphere north }
  schedule rooms
  legend

  accTitle "Railroad walk-up apartment, unit 3R"
  accDescr "A 3.7 by 18.3 metre apartment on a shared urban lot, 3.1 metres wide inside. A 900 mm corridor runs the full depth from the street door to the rear wall; six rooms hang off its west side in a line — living, bedroom, kitchen, a second bedroom, the bathroom and a back room. Only the street and rear walls can hold windows; the two long sides are party walls shared with the neighbouring buildings."

  # ------------------------------------------------------------------- shell
  # Both long walls are party walls: 300 mm of shared masonry with someone
  # else's apartment on the far side. You cannot cut a window into either one.
  wall id=w_west   exterior thickness 300 { (0,0) (0,18000) }
  wall id=w_east   exterior thickness 300 { (3400,0) (3400,18000) }
  wall id=w_street exterior thickness 300 { (0,0) (3400,0) }
  wall id=w_back   exterior thickness 300 { (0,18000) (3400,18000) }

  # The corridor wall. One partition, 18 m long, running the entire depth of
  # the apartment — every room in the unit opens off this one line.
  wall id=w_hall partition thickness 100 { (2300,0) (2300,18000) }

  # Cross partitions, front to back. Each is named for the two rooms it divides.
  wall id=p_living_bed1   partition thickness 100 { (0,4600)  (2300,4600) }
  wall id=p_bed1_kitchen  partition thickness 100 { (0,7400)  (2300,7400) }
  wall id=p_kitchen_bed2  partition thickness 100 { (0,11200) (2300,11200) }
  wall id=p_bed2_bath     partition thickness 100 { (0,12900) (2300,12900) }
  wall id=p_bath_office   partition thickness 100 { (0,15000) (2300,15000) }

  # ------------------------------------------------------------------- rooms
  # The corridor is a room in its own right, and it is the second-largest room
  # in the apartment. 19.8 m² of hallway in a 61 m² unit.
  room id=r_hall at (2300,0) size 1100x18000 label "Hall" uses circulation hall

  room id=r_living  at (0,0)     size 2300x4600 label "Living"          uses living
  room id=r_bed1    at (0,4600)  size 2300x2800 label "Bedroom 1"       uses bedroom
  room id=r_kitchen at (0,7400)  size 2300x3800 label "Kitchen"         uses kitchen
  room id=r_bed2    at (0,11200) size 2300x1700 label "Bedroom 2*"      uses bedroom
  room id=r_bath    at (0,12900) size 2300x2100 label "Bath"            uses bath
  room id=r_office  at (0,15000) size 2300x3000 label "Bonus Room*"     uses office

  # ------------------------------------------------------------------- doors
  # The street door opens into the corridor, which is 900 mm wide.
  door id=d_front on w_street at 2850 width 900 swing into r_hall

  door id=d_living  on w_hall at 3900  width 800 swing into r_living
  door id=d_bed1    on w_hall at 6000  width 700 hinge near start swing into r_bed1
  door id=d_kitchen on w_hall at 8200  width 800 swing into r_kitchen
  door id=d_bed2    on w_hall at 12050 width 700 swing into r_bed2
  door id=d_office  on w_hall at 16500 width 800 swing into r_office

  # The bathroom has NO door onto the corridor. Its only door is off Bedroom 2 —
  # so the second bedroom is also the hallway to the only toilet in the unit.
  # It is 600 mm wide, which is what was left over.
  door id=d_bath on p_bed2_bath at 1150 width 600 swing into r_bath

  # ----------------------------------------------------------------- windows
  # Two. In an 18-metre-deep apartment.
  window id=win_living on w_street at 1150 width 1500
  window id=win_office on w_back   at 1150 width 900

  # --------------------------------------------------------------- the hall
  # The corridor's last stretch is past the last door, so it is where the bicycle
  # lives. There is nowhere else to keep a bicycle. Parked back here it obstructs
  # nothing the linter can measure, which is the only good news on this drawing.
  furniture id=f_bike bike at (2350,17450) size 900x400 label "Bike" in r_hall

  # -------------------------------------------------------------- the living
  furniture id=f_sofa sofa in r_living anchor left flush size 850x2000 label "Sofa"
  furniture id=f_tv   tv   at (1950,600) size 300x1100 label "TV" in r_living

  # ------------------------------------------------------------- bedroom one
  # A full-size bed and a wardrobe. The wardrobe goes where the wardrobe fits,
  # which is behind the door.
  furniture id=f_bed1  bed  in r_bed1 anchor left flush size 1400x1900 label "Bed"
  furniture id=f_robe1 robe at (1650,6450) size 600x900 label "Wardrobe" in r_bed1

  # ------------------------------------------------------------- the kitchen
  # A galley along the party wall, and — the listing photo's proudest moment —
  # a full-depth American refrigerator on the wall opposite.
  furniture id=f_counter counter      against wall w_west offset 8250  size 1600x600 in r_kitchen
  furniture id=f_sink    kitchen_sink against wall w_west offset 9450  in r_kitchen
  furniture id=f_stove   stove        against wall w_west offset 10150 in r_kitchen
  furniture id=f_fridge  fridge       against wall w_hall offset 8750  size 700x900 in r_kitchen
  furniture id=f_ktable  table at (900,10300) size 900x700 label "Table" in r_kitchen

  # ------------------------------------------------------------- bedroom two
  # "Bedroom 2" is 1.7 m deep. The bed goes across it, and what is left is the
  # route to the bathroom.
  furniture id=f_bed2 bed at (150,11250) size 1800x1000 label "Bed (twin)" in r_bed2

  # ------------------------------------------------------------------- bath
  furniture id=f_wc     wc     against wall w_west offset 13500 in r_bath
  furniture id=f_basin  basin  against wall w_west offset 14100 in r_bath
  furniture id=f_shower shower against wall w_hall offset 14400 size 900x900 in r_bath

  # -------------------------------------------------------------- back room
  # Marketed as a home office. The circulation model measures the walk to it from
  # the front door at 17.9 m — the longest indoor commute in a one-bedroom.
  furniture id=f_desk  desk  in r_office anchor left flush size 600x1400 label "Desk"
  furniture id=f_chair chair at (800,16300) size 450x450 in r_office

  title {
    project "Unit 3R — $2,950/mo"
    drawn_by "ArchLang"
    date "2026-08-25"
  }
}
