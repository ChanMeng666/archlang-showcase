# 742 Evergreen Terrace — ground floor.
#
# Fan art: an original architectural drawing of a layout that exists only as a set of
# camera angles and one floor plan a show writer published in 2020. Not affiliated with
# the show or its rights holders; no marks, logos or character names appear here.
#
# The plan is an L on its own lot: a five-metre-deep front band facing the street —
# living room, stair hall, dining room, each of the two front rooms carrying a canted
# bay — with a service wing behind it and the garage/rumpus block attached along the
# east. The notch the L leaves in the north-west corner is the back yard.
#
# Nothing is positioned twice. Every opening is pinned to a named wall, every plumbing
# and kitchen fixture resolves `against wall` or `in <room> anchor …`, so the drawing
# still holds together if a partition moves.
plan "742 Evergreen Terrace" {
  units mm
  grid 50            # exterior 200, partitions 100 — every inner face lands on a …50
  paper A2 landscape
  scale 1:50
  north up
  # Dimensions are hand-placed rather than `dims auto`. The automatic chains take
  # every dimensioned facade, and this building has a notch in it: the west chain's
  # witness lines then run six metres across the back yard to reach the service
  # wing. Five chains round the outside of the L say the same thing and leave the
  # yard empty, which is what a yard is.

  # The house fronts the street on the south, in the northern hemisphere: `street` is
  # the front facade, `back` the yard with the tree in it. Draws nothing; it only names
  # the five directions `arch describe --json --select site` reports.
  site { street south hemisphere north }

  accTitle "742 Evergreen Terrace, ground floor"
  accDescr "The ground floor of a two-storey suburban house with an attached garage. The front door opens straight into the living room, which has a canted bay window; a stair hall sits beside it and a dining room with a second bay is on the far side. Behind them a service wing holds the kitchen, a back hall, a bathroom and a laundry. The garage is attached along the east, with the rumpus room behind it."

  # ───────────────────────────────────────────────────────────────────────────
  # SHELL
  # The front wall carries both bays in its own path: base, cant, face, cant,
  # back to the facade. A bay is not an element in this language — it is a wall
  # that leaves the line and comes back, with a window on the face it makes.
  # ───────────────────────────────────────────────────────────────────────────
  wall id=w_front exterior thickness 200 {
    (0,11000) (1200,11000) (1900,11700) (3500,11700) (4200,11000)
    (8800,11000) (9500,11700) (11100,11700) (11800,11000) (16000,11000)
  }
  wall id=w_west exterior thickness 200 { (0,6000) (0,11000) }
  wall id=w_yard exterior thickness 200 { (0,6000) (6000,6000) }   # living room, onto the back yard
  wall id=w_side exterior thickness 200 { (6000,6000) (6000,0) }   # service wing, west face
  wall id=w_rear exterior thickness 200 { (6000,0) (16000,0) }
  wall id=w_east exterior thickness 200 { (16000,0) (16000,11000) }

  # Partitions. `p_garage` and `p_rumpus` are the party walls the attached garage
  # shares with the house, so they are 200 like the shell rather than 100.
  wall id=p_liv    partition thickness 100 { (6000,6000) (6000,11000) }
  wall id=p_din    partition thickness 100 { (8400,6000) (8400,11000) }
  wall id=p_spine  partition thickness 100 { (6000,6000) (12000,6000) }
  wall id=p_wing   partition thickness 100 { (8400,0) (8400,6000) }
  wall id=p_bath   partition thickness 100 { (6000,4000) (8400,4000) }
  wall id=p_laun   partition thickness 100 { (6000,2000) (8400,2000) }
  wall id=p_garage partition thickness 200 { (12000,0) (12000,11000) }
  wall id=p_rumpus partition thickness 200 { (12000,4000) (16000,4000) }

  # ───────────────────────────────────────────────────────────────────────────
  # ROOMS
  # ───────────────────────────────────────────────────────────────────────────
  # The two front rooms are POLYGONS, not rectangles, and the reason is the bay: a
  # rectangle stops at the facade, so the bay window would sit on a wall no room
  # touches — drawn, but belonging to nothing, and invisible to `describe()`. The
  # ring walks out into the bay and back, so the floor really goes there, the area
  # is the exact shoelace figure, and the window is attributed to the room it lights.
  room id=r_living polygon
    (0,6000) (6000,6000) (6000,11000) (4200,11000) (3500,11700) (1900,11700) (1200,11000) (0,11000)
    label "Living Room" uses living
  room id=r_hall    at (6000,6000)  size 2400x5000 label "Stair Hall"   uses hall circulation
  room id=r_dining polygon
    (8400,6000) (12000,6000) (12000,11000) (11800,11000) (11100,11700) (9500,11700) (8800,11000) (8400,11000)
    label "Dining Room" uses dining
  room id=r_back    at (6000,4000)  size 2400x2000 label "Back Hall"    uses hall circulation
  room id=r_bath    at (6000,2000)  size 2400x2000 label "Bathroom"     uses bath
  room id=r_laundry at (6000,0)     size 2400x2000 label "Laundry"      uses utility
  room id=r_kitchen at (8400,0)     size 3600x6000 label "Kitchen"      uses kitchen
  room id=r_garage  at (12000,4000) size 4000x7000 label "Garage"       uses storage
  room id=r_rumpus  at (12000,0)    size 4000x4000 label "Rumpus Room"  uses living

  # ───────────────────────────────────────────────────────────────────────────
  # THE FRONT
  # The front door is the whole point of the layout: there is no vestibule, no
  # coat lobby, nothing. It lands you in the middle of the family's main room.
  # ───────────────────────────────────────────────────────────────────────────
  door id=d_front at (5000,11000) width 1000 wall w_front hinge left swing into r_living
  window id=win_bay_living at (2700,11700) width 1200 wall w_front    # the bay, on its face
  window id=win_bay_dining at (10300,11700) width 1200 wall w_front   # and the dining bay
  window id=win_hall at (7200,11000) width 600 wall w_front           # light on the stairs

  # The garage door is a leafless `opening`: a sectional door lifts overhead, so it
  # sweeps no floor and there is no leaf to draw — but it still connects the garage
  # to the outside in the access graph, which a plain gap in the wall would not.
  opening id=o_garage at (14000,11000) width 2400 wall w_front

  # ───────────────────────────────────────────────────────────────────────────
  # THE REST OF THE OPENINGS
  # ───────────────────────────────────────────────────────────────────────────
  # Living room out to the hall, hall out to the dining room: both south of the
  # flight, so the cross-passage runs clear in front of the bottom step.
  opening id=o_liv_hall at (6000,10300) width 1000 wall p_liv
  opening id=o_hall_din at (8400,10300) width 1000 wall p_din
  # Hall through to the back of the house, in the 1300 mm beside the stair.
  opening id=o_hall_back at (6700,6000) width 1000 wall p_spine
  # Dining room to kitchen — the wide one, so the table is served from the range.
  opening id=o_din_kit at (10000,6000) width 1800 wall p_spine
  opening id=o_back_kit at (8400,5000) width 1000 wall p_wing

  # A pocket for the bathroom: a 2.4 x 2.0 m room has nowhere to put a leaf that
  # does not foul either the hall or the basin. `p_bath` is walked west to east, so
  # `slide right` drives the panel into the 1100 mm of solid wall east of the jamb;
  # `slide left` would aim it at the 500 mm to the outside corner, against the
  # 850 mm an 800 mm panel needs, and `W_POCKET_RUN` would say so.
  door id=d_bath pocket at (6900,4000) width 800 wall p_bath slide right
  # The laundry folds rather than swings: a hinged leaf here has only the machines
  # or the kitchen to open over, and a bifold sweeps neither.
  door id=d_laundry bifold at (8400,1000) width 800 wall p_wing

  # The side door. You can get from the car to the kitchen without crossing the
  # hall, which is the one piece of circulation everybody who knows this house
  # already knows.
  door id=d_side at (12000,5000) width 900 wall p_garage hinge left swing into r_kitchen
  # And the rumpus room, reached off the kitchen rather than through the garage.
  door id=d_rumpus at (12000,2000) width 800 wall p_garage hinge left swing into r_rumpus
  # Back door to the yard.
  door id=d_back at (9200,0) width 900 wall w_rear hinge left swing into r_kitchen

  window id=win_living_w at (0,8500)     width 1200 wall w_west
  window id=win_living_n at (4600,6000)  width 1400 wall w_yard
  window id=win_bath     at (6000,3000)  width 600  wall w_side
  window id=win_laundry  at (6000,1000)  width 600  wall w_side
  window id=win_kitchen  at (10500,0)    width 1400 wall w_rear   # over the sink
  window id=win_rumpus_n at (14000,0)    width 1600 wall w_rear
  window id=win_rumpus_e at (16000,2000) width 1200 wall w_east
  window id=win_garage   at (16000,8000) width 900  wall w_east

  # ───────────────────────────────────────────────────────────────────────────
  # THE STAIR
  # Against the east side of the hall, entered from the front: `dir up` is walked
  # from the larger-y end, so you come in the front door, turn right through the
  # opening, and the flight is facing you.
  # ───────────────────────────────────────────────────────────────────────────
  stair id=s_up at (7350,6200) size 1000x3400 dir up

  # ───────────────────────────────────────────────────────────────────────────
  # FIXTURES
  # ───────────────────────────────────────────────────────────────────────────
  # Living room: the television against the back wall and the sofa square in front
  # of it, which is the only arrangement this room has ever been drawn in.
  furniture id=f_tv tv against wall w_yard offset 3000 size 1200x400 label "TV" in r_living
  # A polygon room refuses `anchor`/`centered` rather than approximating them on a
  # bounding box it does not fill (E_PLACE_POLY), so the sofa, the coffee table and
  # the dining table below are placed at a coordinate instead.
  furniture id=f_sofa sofa  at (1800,8700) size 2400x900 label "Sofa"         in r_living
  furniture id=f_ctab table at (2450,7550) size 1100x550 label "Coffee Table" in r_living

  furniture id=f_dtab table at (9300,8000) size 1800x1000 label "Dining Table" in r_dining

  # Kitchen: sink under the window, range and worktop continuing the run to the
  # corner, all three on the back wall. Only the fridge is on the party wall, and
  # it sits in the one gap that wall has — between the rumpus door and the garage
  # door, 700 mm clear of each. A first draft ran range and counter down that wall
  # instead, and `arch lint` reported it as two pinched WALKS rather than as a
  # collision: 500 mm to the garage, 300 mm to the rumpus room.
  furniture id=f_sink   kitchen_sink against wall w_rear   offset 4500 in r_kitchen
  furniture id=f_stove  stove        against wall w_rear   offset 5200 in r_kitchen
  furniture id=f_counter counter     against wall w_rear   offset 5700 size 400x600 in r_kitchen
  furniture id=f_fridge fridge       against wall p_garage offset 3450 in r_kitchen
  # The breakfast table sits well west of centre. It has to: the fridge's working
  # clearance and the table between them left a 500 mm walk to the two doors in the
  # party wall, and `lint` reports that as a route, not as a collision.
  furniture id=f_ktab table at (8650,2500) size 1100x800 label "Kitchen Table" in r_kitchen

  # Both sanitary fixtures go on the far side of the room from the door: the
  # doorway wants 300 mm clear either side of its landing, and a 2.25 m room
  # only has one wall that far from an 800 mm opening.
  furniture id=f_basin basin in r_bath anchor top-right    flush size 600x450
  furniture id=f_wc    wc    in r_bath anchor bottom-right flush size 400x700

  furniture id=f_wash counter in r_laundry anchor top-left flush size 1200x600 label "Washer / Dryer"

  # The garage. A car is not a fixture the language knows, so it is a labelled
  # rectangle at a sedan's footprint — which is the honest way to draw one.
  furniture id=f_car  car     in r_garage centered size 1800x4400 label "Car"
  furniture id=f_bench counter against wall p_rumpus offset 2400 size 1600x600 label "Workbench" in r_garage

  furniture id=f_rsofa sofa  in r_rumpus anchor bottom-right flush inset 300 size 2000x800 label "Sofa"
  furniture id=f_rtab  table in r_rumpus anchor top-left     flush inset 300 size 1400x900 label "Games Table"

  # ───────────────────────────────────────────────────────────────────────────
  # DIMENSIONS
  # Endpoint order picks the side: the offset runs along the left normal of
  # from->to, so each of these is written in the direction that throws it OUT of
  # the building. Reverse any one of them and `W_DIM_INSIDE` says so.
  # ───────────────────────────────────────────────────────────────────────────
  dim faces (0,11000)->(12000,11000)  offset 700   # house, on the street
  dim faces (0,11000)->(16000,11000)  offset 1600  # overall, garage included
  dim faces (16000,11000)->(16000,0)  offset 700   # overall depth, east side
  dim faces (16000,0)->(6000,0)       offset 700   # the back of the service wing
  dim faces (0,6000)->(0,11000)       offset 700   # west return
  # The living room's yard wall is deliberately NOT dimensioned. It faces into the
  # notch of the L, and `W_DIM_INSIDE` fires on a chain there whichever way round it
  # is written: the rule asks whether the line falls inside the plan's extent, and
  # the back yard is inside the extent of an L-shaped building without being inside
  # the building. The two overall chains carry the same information.

  schedule rooms
  legend

  title {
    project "742 Evergreen Terrace — Ground Floor"
    drawn_by "ArchLang"
    date "2026-08-25"
  }
}
